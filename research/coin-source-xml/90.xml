            <div type="translation" xml:lang="DE" resp="Klaus Hallof"><ab xmlns="http://www.tei-c.org/ns/1.0"><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(a)"><lb n="1"/>(Münze) des Ewitimos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(b)"><lb n="1"/>(Münze) des Ewitimos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(c)"><lb/><hi rend="smallit">in einer Kartusche</hi><lb n="1"/>(Münze) des Ewitimos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(d)"><lb n="1"/>(Münze) des Zotimos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(e)"><lb n="1"/>(Münze) des Eweti-<lb n="2"/>mos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(f)"><lb n="1"/>(Münze) des Zotimos.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(g)"><lb n="1"/>(Münze) des Ewetimos.</div></ab></div><div type="translation" xml:lang="GRC" resp=" "><ab xmlns="http://www.tei-c.org/ns/1.0"><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(a)"><lb n="1"/>Ἐϝιτίμω. ←</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(b)"><lb n="1"/>[Ἐ]ϝ̣ι̣τίμω. ←</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(c)"><lb/><hi rend="smallit">in area oblonga expressa</hi><lb n="1"/>Ἐϝιτίμω. ←</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(d)"><lb n="1"/>Ζωτίμω. ←</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(e)"><lb n="1"/>Ἐϝιτί‒  →<lb n="2"/>μω.</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(f)"><lb n="1"/>Ζωτίμω. ←</div><div xmlns="http://www.tei-c.org/ns/1.0" type="textpart" subtype="fragment" n="(g)"><lb n="1"/>Ἐϝετίμω. ←</div></ab></div>
